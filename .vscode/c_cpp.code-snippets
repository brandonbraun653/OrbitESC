	"NewCHeader":{
		"description": "Boilerplate for a new C header file",
		"scope": "c",
		"prefix": "avn_new_c_header",
		"body": [
		  "/******************************************************************************",
		  " *  File Name:",
		  " *    $TM_FILENAME",
		  " *",
		  " *  Description:",
		  " *    ${1:Insert Description}",
		  " *",
		  " *  $CURRENT_YEAR | Brandon Braun | brandonbraun653@protonmail.com",
		  " *****************************************************************************/",
		  "",
		  "#pragma once",
		  "#ifndef ${2}_HPP",
		  "#define ${2}_HPP",
		  "",
		  "#ifdef __cplusplus",
		  "extern \"C\"",
		  "{",
		  "#endif",
		  "",
		  "/*-----------------------------------------------------------------------------",
		  "Includes",
		  "-----------------------------------------------------------------------------*/",
		  "$0",
		  "",
		  "#ifdef __cplusplus",
		  "}",
		  "#endif",
		  "#endif  /* !${2}_HPP */",
		  ""
		]
	  },

